{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Praxis Creator Commitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "version",
    "creator",
    "contribution",
    "cityNeed",
    "commitment",
    "wallet",
    "timestamp"
  ],
  "properties": {
    "project": {
      "type": "string",
      "const": "Praxis Creator Commitment"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "creator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "contribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "cityNeed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "commitment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "wallet": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
